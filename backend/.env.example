# Copy to .env. Every value has a safe default except those marked REQUIRED FOR PRODUCTION.
# production: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./floodguard.db
SCHEDULER_ENABLED=true
PIPELINE_INTERVAL_MINUTES=60
CORS_ORIGINS=*

# REQUIRED FOR PRODUCTION: enables /admin/*. Empty disables those routes.
ADMIN_API_KEY=

# console = log messages instead of sending them. thrivewave = real SMS.
SMS_PROVIDER=console
THRIVEWAVE_API_URL=
THRIVEWAVE_API_KEY=
THRIVEWAVE_SENDER_ID=
# REQUIRED if the provider forwards inbound SMS: shared secret for /webhooks/sms/inbound.
INBOUND_WEBHOOK_SECRET=
# Spend guard: stop sending after this many SMS in one cycle (most severe are sent first).
MAX_SMS_PER_CYCLE=500
